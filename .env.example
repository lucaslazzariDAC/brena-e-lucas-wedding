# Copy this to .env and fill in values from YOUR OWN Supabase project
# (Dashboard > Project Settings > API), not the old Lovable-managed project.

# Server-side (no VITE_ prefix — never sent to the browser)
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# Client-side (VITE_ prefix — baked into the browser bundle at build time).
# Same values as above, just duplicated with the VITE_ prefix.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Optional — only needed if you use the Google Maps embed / directions button
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=""
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=""

# Not currently used by the app (client.server.ts is unused), but present for
# completeness if you later add trusted server-side admin operations.
# SUPABASE_SERVICE_ROLE_KEY=""
